{
  "cmake.sourceDirectory": "${workspaceFolder}/VacuumRacing3D",
  "cmake.buildDirectory": "${workspaceFolder}/VacuumRacing3D/build",
  "cmake.configureOnOpen": true,
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",
  "files.associations": {
    "*.h": "cpp",
    "*.cpp": "cpp",
    "*.glsl": "glsl"
  }
}